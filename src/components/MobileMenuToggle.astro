---
// Przycisk otwierający szufladę nawigacji (popover `#starlight__sidebar`) poniżej 900px.
// Pozycja i rozmiar (44x44) w src/styles/layout.css, `.menu-toggle`.
---

<button
  type="button"
  popovertarget="starlight__sidebar"
  class="menu-toggle"
  aria-controls="starlight__sidebar"
  aria-label={Astro.locals.t('menuButton.accessibleLabel')}
>
  <svg
    width="22"
    height="22"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M4 7h16M4 12h16M4 17h16"></path>
  </svg>
</button>
