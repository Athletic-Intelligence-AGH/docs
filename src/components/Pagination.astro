---
import { ui } from './ui-strings';

const { pagination, lang } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
const t = ui(lang);

const arrow = 'M5 12h14M13 6l6 6-6 6';
const arrowBack = 'M19 12H5M11 6l-6 6 6 6';
---

{(prev || next) && (
  <nav class="pager print:hidden" aria-label={t.pagerLabel}>
    {prev ? (
      <a class="card" href={prev.href} rel="prev">
        <span class="ov mu">{Astro.locals.t('page.previousLink')}</span>
        <span class="h">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d={arrowBack} />
          </svg>
          {prev.label}
        </span>
      </a>
    ) : (
      <span />
    )}
    {next && (
      <a class="card r" href={next.href} rel="next">
        <span class="ov mu">{Astro.locals.t('page.nextLink')}</span>
        <span class="h">
          {next.label}
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d={arrow} />
          </svg>
        </span>
      </a>
    )}
  </nav>
)}
