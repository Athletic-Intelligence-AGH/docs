---
import { ui } from './ui-strings';

const t = ui(Astro.locals.starlightRoute.lang);
---

<theme-toggle data-to-light={t.themeToLight} data-to-dark={t.themeToDark}>
  <button type="button" class="pill pill-icon" aria-label={t.themeToLight}>
    <svg
      class="icon-sun"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </svg>
    <svg
      class="icon-moon"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
    </svg>
  </button>
</theme-toggle>

<style is:global>
  theme-toggle {
    display: inline-flex;
  }
  /* Ikona pokazuje akcję: słońce w ciemnym motywie (przełącz na jasny), księżyc w jasnym. */
  :root[data-theme='light'] theme-toggle .icon-sun,
  :root:not([data-theme='light']) theme-toggle .icon-moon {
    display: none;
  }
</style>

<script>
  const KEY = 'starlight-theme';

  function currentTheme() {
    return document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
  }

  function syncLabels() {
    const light = currentTheme() === 'light';
    document.querySelectorAll<HTMLElement>('theme-toggle').forEach((el) => {
      const label = light ? el.dataset.toDark : el.dataset.toLight;
      if (label) el.querySelector('button')?.setAttribute('aria-label', label);
    });
  }

  class ThemeToggle extends HTMLElement {
    constructor() {
      super();
      this.querySelector('button')?.addEventListener('click', () => {
        const next = currentTheme() === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem(KEY, next);
        } catch {
          /* tryb prywatny: preferencja nie zostanie zapamiętana */
        }
        syncLabels();
      });
      syncLabels();
    }
  }
  customElements.define('theme-toggle', ThemeToggle);
</script>
