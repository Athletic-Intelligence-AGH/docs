---
// Wewnętrzny helper dla Sidebar.astro: lista linków (rekurencyjnie dla zagnieżdżonych grup).
import type { StarlightRouteData } from '@astrojs/starlight/route-data';

type Entry = StarlightRouteData['sidebar'][number];

interface Props {
  entries: Entry[];
  nested?: boolean;
}

const { entries, nested = false } = Astro.props;

/** Atrybuty z konfiguracji sidebara bez `class` (klasę składamy sami). */
const attrsOf = (attrs: Record<string, unknown>) =>
  Object.fromEntries(Object.entries(attrs).filter(([key]) => key !== 'class'));
---

<ul class:list={['nav-list', { nested }]}>
  {entries.map((entry) =>
    entry.type === 'link' ? (
      <li>
        <a
          {...attrsOf(entry.attrs)}
          class:list={['nl', entry.attrs.class]}
          href={entry.href}
          aria-current={entry.isCurrent ? 'page' : undefined}
        >
          <span>{entry.label}</span>
          {/^https?:\/\//.test(entry.href) && (
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M7 17 17 7M8 7h9v9" />
            </svg>
          )}
        </a>
      </li>
    ) : (
      <li>
        <p class="sub-label">{entry.label}</p>
        <Astro.self entries={entry.entries} nested />
      </li>
    ),
  )}
</ul>
